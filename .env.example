# ==============================================================================
# FreeFlow Linux Configuration Template
# Place this in ~/.config/freeflow/.env or project root, or configure via Settings GUI
# ==============================================================================

# [Required] Groq Cloud API Key (Get a free key at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# [Hotkey Configuration]
# Modifier: KEY_LEFTALT, KEY_RIGHTALT, KEY_LEFTCTRL, KEY_LEFTSHIFT, KEY_LEFTMETA, or blank for single key
HOTKEY_MODIFIER=KEY_LEFTALT

# Trigger Key: KEY_R, KEY_SPACE, KEY_F9, KEY_D, etc.
HOTKEY_KEY=KEY_R

# Hotkey Mode: 'toggle' (press once to start, press again to stop) or 'hold' (push-to-talk)
HOTKEY_MODE=toggle

# [Speech-to-Text Model]
# Options: whisper-large-v3 (recommended), whisper-large-v3-turbo, distil-whisper-large-v3-en
TRANSCRIPTION_MODEL=whisper-large-v3

# [LLM Text Formatting]
# Whisper-large-v3 provides native punctuation and capitalization.
# Set to true only if you want aggressive filler word stripping via an LLM.
FORMAT_TEXT=false
FORMAT_MODEL=llama-3.1-8b-instant

# [Audio Capture]
# 16000 Hz is Whisper's native audio rate (smallest payload, fastest transcription)
SAMPLE_RATE=16000

# [Text Injection]
# Delay in seconds to allow modifier keys to release before injecting text
INJECT_DELAY=0.15

# [Visual Feedback]
SHOW_HUD=true
ENABLE_NOTIFICATIONS=true
